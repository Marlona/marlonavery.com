---
/**
 * Site footer component - 3-column layout
 */
import { SITE_CONFIG, SOCIAL_LINKS, NAV_LINKS, RESUME_PATH } from '../../config';
import { withBasePath } from '../../utils/paths';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import GitHubIcon from '../icons/GitHubIcon.astro';
---

<footer class="border-t border-[var(--border-default)] mt-16 bg-[var(--color-surface)]">
	<div class="container mx-auto px-4 py-12">
		<!-- Positioning Statement -->
		<div class="mb-8 pb-8 border-b border-[var(--border-subtle)]">
			<p class="heading-sm text-foreground mb-2">{SITE_CONFIG.name}</p>
			<p class="body-sm text-muted max-w-md">Applied AI executive, engineer, educator, and speaker. Building AI systems. Teaching others. Inspiring what's next.</p>
		</div>

		<!-- Main Footer Content -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
			<!-- Navigation -->
			<div>
				<h3 class="label mb-4">Navigation</h3>
				<ul class="space-y-2">
					{NAV_LINKS.map((link) => (
						<li>
							<a
								href={withBasePath(link.href)}
								class="body-sm text-secondary hover:text-foreground transition-colors"
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Connect -->
			<div>
				<h3 class="label mb-4">Connect</h3>
				<ul class="space-y-2">
					<li>
						<a
							href={SOCIAL_LINKS.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<LinkedInIcon class="w-4 h-4" />
							LinkedIn
						</a>
					</li>
					<li>
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<GitHubIcon class="w-4 h-4" />
							GitHub
						</a>
					</li>
					<li>
						<a
							href={SOCIAL_LINKS.email}
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
							Email
						</a>
					</li>
				</ul>
			</div>

			<!-- Resources -->
			<div>
				<h3 class="label mb-4">Resources</h3>
				<ul class="space-y-2">
					<li>
						<a
							href={withBasePath('/experience')}
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
							Experience
						</a>
					</li>
					<li>
						<a
							href={withBasePath('/ai-lab')}
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
							</svg>
							AI Lab
						</a>
					</li>
					<li>
						<a
							href={withBasePath('/playbook')}
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
							</svg>
							Playbook
						</a>
					</li>
					<li>
						<a
							href={withBasePath(RESUME_PATH)}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
							</svg>
							Resume
						</a>
					</li>
					<li>
						<a
							href={withBasePath('/press')}
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
							</svg>
							Press Kit
						</a>
					</li>
					<li>
						<a
							href={withBasePath('/rss.xml')}
							class="inline-flex items-center gap-2 body-sm text-secondary hover:text-foreground transition-colors"
						>
							<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
								<path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36m12.18 4.36a14.36 14.36 0 0 0-14.36-14.36V9a11 11 0 0 1 11 11h3.36m-6.72 0a7.64 7.64 0 0 0-7.64-7.64v3.36a4.28 4.28 0 0 1 4.28 4.28h3.36z"/>
							</svg>
							RSS Feed
						</a>
					</li>
				</ul>
			</div>
		</div>

		<!-- Bottom Bar -->
		<div class="pt-8 border-t border-[var(--border-subtle)] flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
			<p class="body-sm text-muted">
				&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. All rights reserved.
			</p>
			<p class="body-sm text-faint italic">
				Built to make AI useful, accessible, and human.
			</p>
		</div>
	</div>
</footer>
