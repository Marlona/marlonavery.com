---
import type { KeynoteTopic } from '../../data/types';

interface Props {
	topic: KeynoteTopic;
	index: number;
	compact?: boolean;
}

const { topic, index, compact = false } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<div class={`card-premium p-6 ${compact ? '' : 'p-8'}`}>
	<div class="flex items-start gap-4 mb-4">
		<span class="font-mono text-xs shrink-0 mt-1" style="color: var(--accent); opacity: 0.6;">{num}</span>
		<div class="flex-1 min-w-0">
			<div class="flex items-center gap-2 flex-wrap mb-2">
				<h3 class="heading-sm text-foreground">{topic.title}</h3>
				{topic.tier === 'signature' && (
					<span class="badge-tag text-xs font-mono uppercase tracking-wider" style="background: var(--accent); color: #fff; padding: 2px 8px; border-radius: 2px;">
						Signature
					</span>
				)}
			</div>
			{!compact && (
				<p class="body-sm text-secondary leading-relaxed mb-4">{topic.abstract}</p>
			)}
			<div class="flex items-center gap-4 flex-wrap">
				<span class="font-mono text-xs text-secondary">{topic.duration}</span>
				<div class="flex flex-wrap gap-1">
					{topic.audience.map(a => (
						<span class="tag">{a}</span>
					))}
				</div>
			</div>
		</div>
	</div>
</div>
