---
import type { IntentCard } from '../../data/types';

interface Props {
	items: IntentCard[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger-reveal">
	{items.map(item => (
		<a href={item.href} class="card-premium p-5 block group">
			<div class="flex items-start gap-4">
				<span class="text-2xl shrink-0">{item.icon}</span>
				<div>
					<h3 class="heading-sm text-foreground mb-1 group-hover:text-[var(--accent)] transition-colors">
						{item.title}
					</h3>
					<p class="body-xs text-secondary leading-relaxed">{item.description}</p>
				</div>
			</div>
		</a>
	))}
</div>
