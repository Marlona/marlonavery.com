---
interface Props {
	title: string;
	description: string;
	icon?: string;
	n?: string;
}

const { title, description, icon, n } = Astro.props;
const marker = n ?? icon;
---

<div class="card p-5">
	<div class="flex items-start gap-4">
		{marker && (
			<span class="font-mono text-xs font-medium shrink-0 mt-1" style="color: var(--accent-deep); letter-spacing: 0.05em;">
				{marker}
			</span>
		)}
		<div>
			<h3 class="heading-sm text-foreground mb-2">{title}</h3>
			<p class="body-sm text-secondary leading-relaxed">{description}</p>
		</div>
	</div>
</div>
