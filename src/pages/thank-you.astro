---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_CONFIG } from '../config';
---

<PageLayout
	title={`Message Sent | ${SITE_CONFIG.name}`}
	description="Your message was received. Marlon will be in touch within 2–3 business days."
>
	<section class="max-w-2xl mx-auto px-4 py-24 text-center">
		<div class="text-4xl mb-6">✓</div>
		<h1 class="heading-xl text-foreground mb-4">Message sent.</h1>
		<p class="body-lg text-secondary mb-3">
			Thank you for reaching out. I'll review your inquiry and respond within 2–3 business days.
		</p>
		<p class="body-md text-secondary mb-12">
			For time-sensitive requests, email <a href={`mailto:${SITE_CONFIG.email}`} class="link">{SITE_CONFIG.email}</a> directly.
		</p>
		<div class="flex flex-wrap justify-center gap-4">
			<a href="/" class="btn btn-primary">Back to Home</a>
			<a href="/speaking" class="btn btn-secondary">View Speaking Topics</a>
		</div>
	</section>
</PageLayout>
