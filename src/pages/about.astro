---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_CONFIG } from '../config';
import PhilosophyCard from '../components/PhilosophyCard.astro';
import FocusAreaCard from '../components/FocusAreaCard.astro';

// Data imports
import {
	LEADERSHIP_PRINCIPLES,
	STRATEGIC_APPROACH,
	FOCUS_AREAS,
	EXTERNAL_ENGAGEMENT,
	COMPETENCY_GROUPS,
	EDUCATION,
	COMMUNITY,
} from '../data/about';
---

<PageLayout title={`About | ${SITE_CONFIG.name}`} description={`About ${SITE_CONFIG.name} — ${SITE_CONFIG.title}. A decade building Generative AI products, voice systems, and developer communities.`}>
	<section class="max-w-4xl mx-auto px-4 py-12">
		<h1 class="heading-xl text-foreground mb-8">About Me</h1>

		<div class="prose prose-lg text-secondary mb-16 max-w-none">
			<p class="mb-6 body-lg leading-relaxed">
				I'm <strong class="text-foreground">{SITE_CONFIG.name}</strong>, a Generative AI builder, founder, and educator. As <strong class="text-foreground">VP, Applied AI Lead at JPMorgan Chase</strong> and <strong class="text-foreground">Founder & CEO / Chief AI Officer of VoicePath</strong>, I design and ship AI systems that automate real business operations and elevate customer experience — HIPAA-compliant voice agents integrated with EHRs, AI document tools for legal and finance, and applied LLM workflows for the back office of small and mid-sized businesses.
			</p>
			<p class="mb-6 body-lg leading-relaxed">
				Outside the day job, I run <strong class="text-foreground">AImpact</strong>, an AI education organization contracted by <strong class="text-foreground">Microsoft</strong> to architect Azure OpenAI bootcamps and commissioned by <strong class="text-foreground">Google + Dream Machine Innovation Labs</strong> to author the curriculum and headline the <em>AI Library Project</em> — a five-city tour bringing GenAI training to underserved communities. Across 80+ workshops, AImpact has trained 10,000+ professionals with a 40% average productivity lift.
			</p>
			<p class="mb-6 body-lg leading-relaxed">
				I founded <strong class="text-foreground">NextSteps DevCon</strong> and the <strong class="text-foreground">Pledge to Equality Scholarship Program</strong>, which has granted 10,000+ scholarships to underserved communities. I've shared stages with leaders from Google, IBM, and Microsoft, and built one of the first AI Grant Writers on GPT-3 in 2021 (2.5x throughput, 60% labor reduction) — well before the rest of the world caught on.
			</p>
			<p class="body-lg leading-relaxed">
				My approach: ship the systems I lead. The best AI doesn't replace people — it removes the work that was burning them out and gives them more room to do the things only they can do. A Texas native with professional roots in Atlanta and Silicon Valley, I'm now based in <strong class="text-foreground">Washington, DC</strong>.
			</p>
		</div>

		<!-- Quick Stats -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
			<div class="text-center p-4 border border-[var(--border-subtle)] rounded-lg">
				<div class="text-2xl font-bold text-accent font-mono">10+</div>
				<div class="body-sm text-muted mt-1">Years in GenAI</div>
			</div>
			<div class="text-center p-4 border border-[var(--border-subtle)] rounded-lg">
				<div class="text-2xl font-bold text-accent font-mono">10K+</div>
				<div class="body-sm text-muted mt-1">Scholarships</div>
			</div>
			<div class="text-center p-4 border border-[var(--border-subtle)] rounded-lg">
				<div class="text-2xl font-bold text-accent font-mono">80+</div>
				<div class="body-sm text-muted mt-1">Workshops Delivered</div>
			</div>
			<div class="text-center p-4 border border-[var(--border-subtle)] rounded-lg">
				<div class="text-2xl font-bold text-accent font-mono">5+</div>
				<div class="body-sm text-muted mt-1">Ventures Founded</div>
			</div>
		</div>

		<!-- How I Lead (Expanded) -->
		<div id="how-i-lead" class="mb-16 scroll-mt-8">
			<h2 class="heading-lg text-foreground mb-6">How I Lead</h2>
			<p class="body-md text-secondary mb-8 max-w-3xl">
				A decade running ventures and enterprise AI teams in parallel teaches you that leadership is operator-first. Strategy without keyboard time produces decks; the work happens inside the work.
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{LEADERSHIP_PRINCIPLES.map(principle => (
					<PhilosophyCard title={principle.title} description={principle.description} icon={principle.icon} />
				))}
			</div>
		</div>

		<!-- Strategic Approach -->
		<div id="strategic-approach" class="mb-16 scroll-mt-8">
			<h2 class="heading-lg text-foreground mb-6">Strategic Approach</h2>
			<p class="body-md text-secondary mb-8 max-w-3xl">
				Generative AI moves on a quarterly cadence. I build for what is true 18 months from now, not just what shipped last week.
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				{STRATEGIC_APPROACH.map(item => (
					<PhilosophyCard title={item.title} description={item.description} icon={item.icon} />
				))}
			</div>
		</div>

		<!-- Technical Focus Areas -->
		<div id="technical-focus-areas" class="mb-16 scroll-mt-8">
			<h2 class="heading-lg text-foreground mb-6">Where I Spend My Time</h2>
			<p class="body-md text-secondary mb-8 max-w-3xl">
				Five domains where Generative AI meets real business — voice, agents, applied LLMs, education, and equity in tech.
			</p>
			<div class="grid grid-cols-1 gap-6">
				{FOCUS_AREAS.map(area => (
					<div id={area.id} class="scroll-mt-8">
						<FocusAreaCard
							title={area.title}
							summary={area.summary}
							details={area.details}
							metrics={area.metrics}
						/>
					</div>
				))}
			</div>
		</div>

		<!-- External Engagement -->
		<div id="external-engagement" class="mb-16 scroll-mt-8">
			<h2 class="heading-lg text-foreground mb-6">External Engagement</h2>
			<p class="body-md text-secondary mb-8 max-w-3xl">
				Workshops, scholarships, speaking, and the AI With Friends podcast — the work that happens in parallel with the day job, and often does just as much.
			</p>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				{Object.values(EXTERNAL_ENGAGEMENT).map(section => (
					<div class="card p-6">
						<h3 class="heading-sm text-foreground mb-4">{section.title}</h3>
						<ul class="space-y-3">
							{section.items.map(item => (
								<li class="flex items-start text-secondary">
									<span class="mr-2 text-accent mt-1 text-xs">●</span>
									<span class="body-sm">{item}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>

		<!-- Core Competencies -->
		<div id="core-competencies" class="mb-16 scroll-mt-8">
			<h2 class="heading-lg text-foreground mb-6">Core Competencies</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{COMPETENCY_GROUPS.map(group => (
					<div class="card p-6">
						<h3 class="heading-sm text-foreground mb-4">{group.title}</h3>
						<ul class="space-y-2">
							{group.skills.map(skill => (
								<li class="flex items-center space-x-3 text-secondary">
									<span class="w-2 h-2 bg-[var(--color-accent)] rounded-full shrink-0"></span>
									<span class="body-md">{skill}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>

		<!-- Education & Certifications -->
		{EDUCATION.length > 0 && (
			<div id="education" class="mb-16 scroll-mt-8">
				<h2 class="heading-lg text-foreground mb-6">Education & Certifications</h2>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{EDUCATION.map(item => (
						<div class="card p-6">
							<h3 class="font-semibold text-foreground mb-1">{item.school}</h3>
							{item.degree && (
								<p class="body-sm text-secondary mb-2">{item.degree}</p>
							)}
							<div class="badge badge-accent text-xs">{item.years}</div>
						</div>
					))}
				</div>
			</div>
		)}

		<!-- Community -->
		<div class="border-t border-[var(--border-default)] pt-12">
			<h2 class="heading-lg text-foreground mb-8">Community</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{COMMUNITY.map(item => (
					<div class="card p-6">
						<h3 class="font-semibold text-foreground mb-1">{item.org}</h3>
						<div class="badge badge-accent text-xs mb-3">{item.role}</div>
						<p class="body-sm text-secondary">{item.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>
</PageLayout>
