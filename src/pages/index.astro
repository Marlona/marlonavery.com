---
import PageLayout from '../layouts/PageLayout.astro';
import ProofStrip from '../components/common/ProofStrip.astro';
import LLMProfilePanel from '../components/common/LLMProfilePanel.astro';
import PhilosophyStrip from '../components/home/PhilosophyStrip.astro';
import WhatBringsYouHere from '../components/home/WhatBringsYouHere.astro';
import IndustrySelectorGrid from '../components/home/IndustrySelectorGrid.astro';
import KeynoteTopic from '../components/speaking/KeynoteTopic.astro';
import EventCard from '../components/events/EventCard.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../config';
import { getBasePath, withBasePath } from '../utils/paths';
import { formatDate } from '../utils/dates';

// Data imports
import { PROOF_METRICS } from '../data/homepage';
import { PHILOSOPHY_STEPS, CREDIBILITY_METRICS, INTENT_CARDS, INDUSTRIES } from '../data/homepage';
import { KEYNOTE_TOPICS } from '../data/speaking';

const base = getBasePath();

// Fetch Latest Blog Posts
const posts = await getCollection('blog', ({ data }) => {
	return import.meta.env.PROD ? data.draft !== true : true;
});
const latestPosts = posts
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);

// Fetch upcoming events
const allEvents = await getCollection('events');
const upcomingEvents = allEvents
	.filter(e => e.data.status === 'upcoming')
	.sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
	.slice(0, 3);
const featuredPastEvents = allEvents
	.filter(e => e.data.status === 'past' && e.data.featured)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 2);
const featuredEvents = upcomingEvents.length > 0 ? upcomingEvents : featuredPastEvents;

// LLM profile data (for structured crawlability)
const llmProfileData = {
	name: SITE_CONFIG.name,
	title: SITE_CONFIG.title,
	currentRole: SITE_CONFIG.currentRole,
	currentCompany: SITE_CONFIG.currentCompany,
	yearsExperience: 10,
	domains: ['Generative AI', 'Voice AI & Conversational Agents', 'AI Agents & Automation', 'AI Education & Workshops'],
	techStack: ['OpenAI GPT-4o / Anthropic Claude', 'Azure OpenAI · LangChain · RAG', 'OCR & Document Intelligence', 'Vector DBs (Pinecone, Chroma)', 'LLMOps / MLOps', 'Python · TypeScript · Azure · GCP'],
	expertise: ['Generative AI strategy and product design', 'Voice AI for business operations', 'AI agents and workflow automation', 'Document AI and retrieval augmented generation', 'AI education and workforce enablement', 'Founding and scaling AI ventures'],
	notableAchievements: [
		'Founder & CEO / Chief AI Officer of VoicePath — HIPAA-compliant voice agents (Veradigm EHR), 60% faster patient comms, 50% less admin workload',
		'VP, Applied AI Lead at JPMorgan Chase',
		'Built one of the first AI Grant Writers on GPT-3 (2021) — 2.5x throughput, 60% labor reduction',
		'Contracted by Microsoft to architect Azure OpenAI bootcamps — 30% lift in certification pass-rates',
		'Commissioned by Google + Dream Machine Innovation Labs for the AI Library Project five-city tour',
		'Trained 10,000+ professionals across 80+ AImpact workshops worldwide — 40% average productivity lift',
		'Founded NextSteps DevCon and Pledge to Equality (10K+ scholarships)',
		'Oxford-certified in AI: Cloud and Edge Implementations (2022); Certified ScrumMaster (CSM)',
	],
};

const initials = SITE_CONFIG.name.split(' ').map(n => n[0]).join('');
const featuredTopics = KEYNOTE_TOPICS.filter(t => t.tier === 'signature').slice(0, 2);
---

<PageLayout title={`${SITE_CONFIG.name} | ${SITE_CONFIG.title}`} description={SITE_CONFIG.description}>

	<!-- 1. HERO -->
	<section class="parallax-hero py-24 md:py-32 relative overflow-hidden" data-hero>
		<div class="max-w-6xl mx-auto px-4">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
				<div class="lg:col-span-8">
					<div class="inline-flex items-center gap-2 mb-6 px-3 py-1.5 rounded-full border text-xs font-medium"
						style="background: var(--bg-card); border-color: var(--border); color: var(--fg-muted);">
						<span style="width: 6px; height: 6px; background: var(--accent); border-radius: 50%;"></span>
						{SITE_CONFIG.currentRole} · {SITE_CONFIG.currentCompany}
					</div>

					<h1 class="display text-foreground mb-8" style="max-width: 900px;">
						Building AI. <em style="color: var(--accent);">Teaching</em> the Future.
					</h1>

					<p class="body-lg text-secondary mb-10" style="max-width: 600px;">
						Applied AI executive, engineer, and educator. I build real AI systems — voice agents, document intelligence, agentic workflows — and then train the next generation of practitioners to do the same.
					</p>

					<div class="flex flex-col sm:flex-row gap-4">
						<a href={withBasePath('/workshops/enroll')} class="btn btn-primary">
							Explore Your AI Journey →
						</a>
						<a href={withBasePath('/writing')} class="btn btn-secondary">
							Read My Writing
						</a>
					</div>
				</div>

				<div class="lg:col-span-4 order-first lg:order-none">
					<figure class="relative rounded-2xl" style="background: var(--bg-well);">
						<img
							src={`${base}/headshot.jpg`}
							alt={SITE_CONFIG.name}
							width="300"
							height="400"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="w-32 h-40 sm:w-36 sm:h-44 lg:w-full lg:h-auto lg:aspect-[3/4] object-cover mx-auto lg:mx-0"
							style="border-radius: var(--r-lg); border: 1px solid var(--border);"
							onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
						/>
						<div
							style="display:none; border-radius: var(--r-lg); border: 1px solid var(--border); background: var(--accent-wash); color: var(--accent-deep);"
							class="w-32 h-40 sm:w-36 sm:h-44 lg:w-full lg:aspect-[3/4] items-center justify-center mx-auto lg:mx-0"
						>
							<span class="text-2xl lg:text-5xl" style={`font-family:var(--font-display); font-weight: 500; letter-spacing: -0.02em;`}>{initials}</span>
						</div>
					</figure>
				</div>
			</div>
		</div>
	</section>

	<!-- Proof Strip -->
	<ProofStrip metrics={PROOF_METRICS} sticky={true} />

	<!-- 2. PHILOSOPHY STRIP -->
	<section class="py-20 px-4">
		<div class="max-w-5xl mx-auto">
			<p class="kicker text-center mb-3">The Philosophy</p>
			<h2 class="heading-xl text-foreground text-center mb-12">Build. Learn. Teach. Inspire.</h2>
			<PhilosophyStrip steps={PHILOSOPHY_STEPS} />
			<div class="text-center mt-8">
				<a href="/about#philosophy" class="link body-sm">How this shapes everything I do →</a>
			</div>
		</div>
	</section>

	<!-- 3. WHAT BRINGS YOU HERE -->
	<section class="py-20 px-4 bg-[var(--color-surface)] border-y border-[var(--border)]">
		<div class="max-w-5xl mx-auto">
			<p class="kicker mb-3">Your Path</p>
			<h2 class="heading-xl text-foreground mb-4">What brings you here?</h2>
			<p class="body-lg text-secondary mb-10 max-w-2xl">
				Whether you're booking a keynote, enrolling in a workshop, or curious about what AI can do for your industry — there's a path for you.
			</p>
			<WhatBringsYouHere items={INTENT_CARDS} />
		</div>
	</section>

	<!-- 4. CREDIBILITY GRID -->
	<section class="py-20 px-4">
		<div class="max-w-4xl mx-auto">
			<p class="kicker text-center mb-3">By the Numbers</p>
			<h2 class="heading-xl text-foreground text-center mb-12">A Decade of Applied AI</h2>
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
				{CREDIBILITY_METRICS.map(m => (
					<div class="text-center p-6 border border-[var(--border-subtle)] rounded-xl">
						<div
							class="text-4xl font-bold font-mono mb-2"
							style={m.highlight ? 'color: var(--accent);' : 'color: var(--foreground);'}
						>
							{m.value}
						</div>
						<div class="body-sm text-secondary leading-snug">{m.label}</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 5. INDUSTRY SELECTOR -->
	<section class="py-20 px-4 bg-[var(--color-surface)] border-y border-[var(--border)]">
		<div class="max-w-5xl mx-auto">
			<p class="kicker mb-3 text-center">Industries</p>
			<h2 class="heading-xl text-foreground text-center mb-4">AI Expertise Across Sectors</h2>
			<p class="body-lg text-secondary text-center mb-10 max-w-2xl mx-auto">
				Select your industry to see how Marlon's speaking and workshops apply to your specific context.
			</p>
			<IndustrySelectorGrid industries={INDUSTRIES} />
		</div>
	</section>

	<!-- 6. FEATURED SPEAKING TOPICS -->
	<section class="py-20 px-4">
		<div class="max-w-5xl mx-auto">
			<p class="kicker mb-3">Speaking</p>
			<h2 class="heading-xl text-foreground mb-4">Signature Keynotes</h2>
			<p class="body-lg text-secondary mb-10 max-w-2xl">
				Talks that shift how your audience thinks about and uses AI. Built from production experience, not slides.
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8">
				{featuredTopics.map((topic, i) => (
					<KeynoteTopic topic={topic} index={i} compact={false} />
				))}
			</div>
			<a href="/speaking" class="link body-sm">See all keynote topics →</a>
		</div>
	</section>

	<!-- 7. FEATURED EVENTS -->
	<section class="py-20 px-4 bg-[var(--color-surface)] border-y border-[var(--border)]">
		<div class="max-w-4xl mx-auto">
			<p class="kicker mb-3">Events</p>
			<h2 class="heading-xl text-foreground mb-10">
				{upcomingEvents.length > 0 ? 'Catch Me Live' : 'Recent Appearances'}
			</h2>
			{featuredEvents.length > 0 ? (
				<div class="space-y-4 stagger-reveal">
					{featuredEvents.map(e => (
						<EventCard id={e.id} event={e.data} variant={e.data.status} />
					))}
				</div>
			) : (
				<div class="card p-8 text-center">
					<p class="body-lg text-secondary mb-4">No events currently scheduled.</p>
					<p class="body-md text-secondary">
						Follow on{' '}
						<a href={`https://linkedin.com/in/${SITE_CONFIG.linkedInUsername}`} class="link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
						{' '}for event announcements.
					</p>
				</div>
			)}
			<div class="mt-8">
				<a href="/events" class="link body-sm">View all events →</a>
			</div>
		</div>
	</section>

	<!-- 8. FEATURED INSIGHTS -->
	{latestPosts.length > 0 && (
		<section id="insights" class="py-20 px-4">
			<div class="max-w-4xl mx-auto">
				<div class="flex justify-between items-baseline mb-10">
					<div>
						<p class="kicker mb-1">Insights</p>
						<h2 class="heading-xl text-foreground">Latest Writing</h2>
					</div>
					<div class="flex gap-4">
						<a href="/ai-lab" class="link body-sm hidden sm:inline">AI Lab →</a>
						<a href={withBasePath('/writing')} class="link body-sm">All articles →</a>
					</div>
				</div>
				<div class="space-y-10">
					{latestPosts.map((post) => (
						<article class="group relative">
							{post.data.heroImage && (
								<a href={`${base}/blog/${post.id}`} class="block mb-4 relative z-10 overflow-hidden rounded-lg">
									<img
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full aspect-[16/9] object-cover border border-[var(--border-default)] transition-transform duration-500 group-hover:scale-105"
										loading="lazy"
									/>
								</a>
							)}
							<div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-2">
								<h3 class="heading-sm text-foreground group-hover:text-accent transition-colors">
									<a href={`${base}/blog/${post.id}`}>
										<span class="absolute inset-0"></span>
										{post.data.title}
									</a>
								</h3>
								<time datetime={post.data.publishDate.toISOString()} class="body-sm text-muted shrink-0 md:ml-4 tabular-nums">
									{formatDate(post.data.publishDate)}
								</time>
							</div>
							<p class="body-md text-secondary mb-3 max-w-2xl">{post.data.description}</p>
							<div class="flex gap-2 relative z-10">
								{post.data.tags.map(tag => (
									<span class="body-sm text-faint">#{tag}</span>
								))}
							</div>
						</article>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- LLM Profile Panel (structured, crawlable) -->
	<section class="max-w-6xl mx-auto px-4 mb-4">
		<LLMProfilePanel person={llmProfileData} />
	</section>

	<!-- 9. FINAL CTA -->
	<section class="cta-gradient relative overflow-hidden py-24 px-4">
		<div class="max-w-3xl mx-auto text-center">
			<p class="kicker mb-4">Let's Connect</p>
			<h2 class="heading-xl text-foreground mb-6">Let's Build What's Next</h2>
			<p class="body-lg text-secondary mb-4 max-w-2xl mx-auto leading-relaxed">
				Whether you need a keynote that reframes how your team thinks about AI, a workshop that builds real capability, or a strategic partner who ships — I'm here for it.
			</p>
			<p class="body-md text-secondary mb-10 max-w-xl mx-auto">
				Keynote speaker. Workshop facilitator. Enterprise AI advisor.
			</p>
			<div class="flex flex-col sm:flex-row justify-center gap-4">
				<a href={withBasePath('/contact')} class="btn btn-accent">
					Schedule a Conversation →
				</a>
				<a href={withBasePath('/workshops')} class="btn btn-secondary">
					Explore Workshops
				</a>
			</div>
		</div>
	</section>

</PageLayout>
